{
  "version": 3,
  "pages404": true,
  "appType": "pages",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/cases/[slug]",
      "regex": "^/cases/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/cases/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/serious/[slug]",
      "regex": "^/serious/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/serious/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/about",
      "regex": "^/about(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/about(?:/)?$"
    },
    {
      "page": "/cases",
      "regex": "^/cases(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/cases(?:/)?$"
    },
    {
      "page": "/manifesto",
      "regex": "^/manifesto(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/manifesto(?:/)?$"
    },
    {
      "page": "/serious",
      "regex": "^/serious(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/serious(?:/)?$"
    }
  ],
  "dataRoutes": [
    {
      "page": "/cases/[slug]",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "dataRouteRegex": "^/_next/data/euHaNDPVBFc_EcxWi9AkK/cases/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/euHaNDPVBFc_EcxWi9AkK/cases/(?<nxtPslug>[^/]+?)\\.json$"
    },
    {
      "page": "/serious/[slug]",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "dataRouteRegex": "^/_next/data/euHaNDPVBFc_EcxWi9AkK/serious/([^/]+?)\\.json$",
      "namedDataRouteRegex": "^/_next/data/euHaNDPVBFc_EcxWi9AkK/serious/(?<nxtPslug>[^/]+?)\\.json$"
    }
  ],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}